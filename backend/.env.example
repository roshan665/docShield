# ==============================================================================
# DocShield FastAPI Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to backend/.env and configure for your deployment environment.
# SECURITY NOTICE: Never commit real credentials, service-role keys, or
# database secrets to source control.
# ==============================================================================

# Server Runtime Environment
# Options: development, staging, production
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Production CORS Security Configuration
# CRITICAL: For production, set to your exact frontend origin(s). Wildcards (*) are rejected.
FRONTEND_URL=https://docshield.yourdomain.gov.in
ALLOWED_ORIGINS=https://docshield.yourdomain.gov.in

# Supabase Infrastructure (PostgreSQL, Storage, Auth)
# Required: Supabase Project API URL and publishable Anon Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Server-side only JWT secret for local cryptographic token verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Optional: Server-side only service-role key (NEVER exposed to frontend/browser)
# Used strictly for server-side maintenance tasks requiring elevated permissions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
