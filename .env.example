# ==============================================================================
# DocShield Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and provide your deployment-specific variables.
# SECURITY NOTICE: Never commit real credentials, service-role keys, or
# private tokens to source control.
# ==============================================================================

# Supabase Public Infrastructure (Publishable)
# Obtained from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# DocShield Authoritative FastAPI Backend Endpoint
# Local Development: http://localhost:8000/api/v1
# Production: https://api.docshield.yourdomain.gov.in/api/v1 (or /api/v1 with reverse proxy)
VITE_API_URL=https://api.docshield.yourdomain.gov.in/api/v1

# CRITICAL SECURITY RULE:
# DO NOT add SUPABASE_SERVICE_ROLE_KEY or database superuser passwords here.
# The frontend client bundle is publicly accessible in user browsers.
